      DB_POSTGRES_HOST=" your DB_POSTGRES_HOST" #Postgres host, e.g. IP address or hostname
      DB_POSTGRES_PORT=" your DB_POSTGRES_PORT" #Postgres port, e.g. 5432
      DB_POSTGRES_USER=" your DB_POSTGRES_USER" #Postgres user
      DB_POSTGRES_PASSWORD=" your DB_POSTGRES_PASSWORD" #Postgres password
      DB_POSTGRES_NAME=" your DB_POSTGRES_NAME" #Postgres database name